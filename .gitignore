# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- ML artifacts / data (regenerated by the pipeline) ----
ml/artifacts/
ml/data/
*.pt
*.joblib
*.ckpt

# ---- Env / secrets ----
.env
*.env
!*.env.example

# ---- Flutter ----
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
mobile/.packages
mobile/lib/l10n/app_localizations*.dart   # generated by flutter gen-l10n
mobile/ios/Pods/
mobile/android/.gradle/
mobile/android/local.properties

# ---- OS / IDE ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml

# ---- Docker ----
*.log

# rendered mermaid intermediates (regenerated by docs/build_pdf.py)
docs/_diagrams/

# ---- Android build caches / signing (never commit keys) ----
mobile/android/.kotlin/
mobile/android/app/.cxx/
mobile/android/key.properties
*.jks
*.keystore
