# ---- Kavach backend environment (copy to .env) ----
KAVACH_ENVIRONMENT=development
KAVACH_JWT_SECRET=please-change-this-to-a-long-random-string
KAVACH_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional persistence — leave unset to run entirely on the synthetic engine
# KAVACH_POSTGRES_URL=postgresql+asyncpg://kavach:kavach@localhost:5432/kavach
# KAVACH_NEO4J_URI=bolt://localhost:7687
# KAVACH_NEO4J_USER=neo4j
# KAVACH_NEO4J_PASSWORD=password

# Providers (default to offline stubs)
KAVACH_TTS_PROVIDER=stub            # stub | gtts | azure | google
KAVACH_STT_PROVIDER=stub            # stub | whisper | azure | google
KAVACH_TRANSLATION_PROVIDER=builtin # builtin | deep_translator | azure

# Warm the ML engine at startup (slower boot, faster first request)
KAVACH_WARM_ENGINE=0
